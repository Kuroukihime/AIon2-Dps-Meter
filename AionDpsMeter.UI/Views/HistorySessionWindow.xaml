<Window x:Class="AionDpsMeter.UI.HistorySessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:h="clr-namespace:AionDpsMeter.UI.ViewModels.History"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=h:HistorySessionViewModel}"
        Title="Session Stats"
        Height="340" Width="740"
        MinHeight="340" MinWidth="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="SessionPanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F141D" Offset="0"/>
            <GradientStop Color="#0B1017" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitleGlassGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A212B36" Offset="0"/>
            <GradientStop Color="#1A161B22" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderGlassGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EE21262D" Offset="0"/>
            <GradientStop Color="#CC1A1F27" Offset="1"/>
        </LinearGradientBrush>
        <!--<Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#384452" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->
        <Style x:Key="TitleMetaPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#20283342"/>
            <Setter Property="BorderBrush" Value="#383A4450"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SessionPanelGradient}"
            BorderBrush="#3A4658"
            BorderThickness="1"
            CornerRadius="8"
            Margin="4"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource TitleGlassGradient}"
                    CornerRadius="7,7,0,0"
                    Padding="10,7"
                    BorderBrush="#2B3440" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="SESSION OVERVIEW"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Opacity="0.9"
                                       Margin="0,0,10,0"/>
                            <Border Background="{Binding StateColor, Converter={StaticResource StringToBrushConverter}}"
                                    CornerRadius="7" Padding="7,2">
                                <TextBlock Text="{Binding StateLabel}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBackgroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding TargetName}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,5"/>

                        <WrapPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource TitleMetaPillStyle}">
                                <TextBlock FontSize="10">
                                    <Run Text="Date " Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <Run Text="{Binding DateDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource TitleMetaPillStyle}">
                                <TextBlock FontSize="10">
                                    <Run Text="Duration " Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <Run Text="{Binding Duration, Mode=OneWay}" Foreground="{StaticResource DpsColorBrush}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button Content="&#x2715;"
                                Width="26" Height="26" FontSize="10"
                                HorizontalAlignment="Right"
                                Click="CloseButton_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#C42B1C" Padding="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column headers -->
            <Border Grid.Row="1"
                    Background="{StaticResource HeaderGlassGradient}"
                    BorderBrush="#2A3440" BorderThickness="0,0,0,1"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="Player" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Damage" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="DPS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DpsColorBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Crit%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CriticalColorBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Back%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BackAttackColorBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="x2%" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DoubleDamageColorBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="Uptime" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="Share" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Player list -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Players}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AlternationCount="2">
                <!--<ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}"/>
                </ListBox.Resources>-->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="#AA0F141D"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#253140" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C2141B26"/>
                            </Trigger>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#B5121822"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Damage % bar background -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Background="{Binding IsUser, Converter={StaticResource BoolToProgressBrushConverter}}"
                                    Opacity="0.4"
                                    CornerRadius="4">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                        <Binding Path="DamagePercentage"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Border Background="Transparent"
                                    Padding="10,5"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="PlayerItem_Click">
                                <Border.Tag>
                                    <Binding/>
                                </Border.Tag>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#184EC9B0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Class icon -->
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                            Background="#252A3442"
                                            BorderBrush="#354657" BorderThickness="1"
                                            Visibility="{Binding HasClassIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image Source="{Binding ClassIcon, Converter={StaticResource SafeImageSourceConverter}}"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    </Border>

                                    <!-- Player name + class -->
                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,6,0">
                                        <TextBlock Text="{Binding PlayerNameDisplay}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClassName}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="  •  "
                                                       FontSize="9"
                                                       Foreground="#5C6774"
                                                       Visibility="{Binding CombatPower, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text=""
                                                       FontSize="9"
                                                       Foreground="#6E7681"
                                                       Visibility="{Binding CombatPower, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding CombatPower}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       Visibility="{Binding CombatPower, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="  •  "
                                                       FontSize="9"
                                                       Foreground="#5C6774"
                                                       Visibility="{Binding IsDeathDisplayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding PlayerDeathsDisplay}"
                                                       FontSize="9"
                                                       Foreground="#D96464"
                                                       Visibility="{Binding IsDeathDisplayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Total damage -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalDamageDisplay}"
                                               FontSize="10.5" FontWeight="Bold"
                                               Foreground="{StaticResource DamageBarBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <!-- DPS -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DpsDisplay}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource DpsColorBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Crit rate -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding CritRateDisplay}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource CriticalColorBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Back attack rate -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding BackAttackRateDisplay}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource BackAttackColorBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Double damage rate -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding DoubleDamageRateDisplay}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource DoubleDamageColorBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="7"
                                               Text="{Binding DurationDisplay}"
                                               FontSize="10" FontFamily="Consolas"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Share % -->
                                    <TextBlock Grid.Column="8"
                                               Text="{Binding DamagePercentDisplay}"
                                               FontSize="10.5" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
