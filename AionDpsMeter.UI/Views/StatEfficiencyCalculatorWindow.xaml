<Window x:Class="AionDpsMeter.UI.StatEfficiencyCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AionDpsMeter.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StatEfficiencyCalculatorViewModel}"
        Title="Stat efficiency calculator"
        Width="980"
        Height="1050"
        MinWidth="860"
        MinHeight="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Language="en-US"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <FontFamily x:Key="MeterMonoFont">pack://application:,,,/AionDpsMeter.UI;component/Assets/Fonts/#JetBrains Mono</FontFamily>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontFamily" Value="{StaticResource MeterMonoFont}"/>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MeterMonoFont}"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="8,2,0,2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource MeterMonoFont}"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <EventSetter Event="PreviewTextInput" Handler="NumericInput_PreviewTextInput"/>
            <EventSetter Event="DataObject.Pasting" Handler="NumericInput_Pasting"/>
        </Style>

        <Style x:Key="ReadOnlyInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#1F2933"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#3D4852"/>
        </Style>

        <Style x:Key="RowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,1,0,1"/>
        </Style>
    </Window.Resources>

    <Border Background="#EB0D1117"  BorderBrush="#3A4658" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#AA161B22" CornerRadius="6,6,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stat efficiency calculator"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontWeight="Bold"
                               FontFamily="{StaticResource MeterMonoFont}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Width="22"
                            Height="22"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#B3C42B1C"
                            Padding="0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                <StackPanel>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Character Stats Snapshot (Read-only)" Style="{StaticResource SectionTitleStyle}"/>

                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Attack" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack (Base)" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding BaseAttack}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack (Gear)" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding GearAttack}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Min Attack" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding MinAttack}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Max Attack" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding MaxAttack}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pve Attack" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding PveAttack}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boss Attack" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding BossAttack}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack inrease %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding AttackIncreasePercent}"/></Grid>
                                </StackPanel>

                                <StackPanel Margin="4,0">
                                    <TextBlock Text="Damage Multipliers" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding DamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Weapon Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding WeaponDamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PvE Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding PveDamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boss Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding BossDamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Crit Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding CriticalDamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Perfect %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding PerfectPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Smite %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding SmitePercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Front Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding FrontDamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Back Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding BackDamageBoostPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cogni Damage Boost %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding RaceDamageBoostPercent}"/></Grid>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Derived Power" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Combat Speed %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource ReadOnlyInputStyle}" Text="{Binding CombatSpeedPercent}"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Stat Window Attack" Style="{StaticResource LabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding StatWindowAttack, StringFormat=N2}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource MeterMonoFont}" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid>
                                    <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Effective Attack" Style="{StaticResource LabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding EffectiveAttack, StringFormat=N2}" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MeterMonoFont}" FontWeight="Bold" Margin="8,0,0,0"/></Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" Margin="0,0,4,8">
                            <StackPanel>
                                <TextBlock Text="Combat Setup" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Buffs" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack Increase % Buff" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding AttackIncreaseCombatPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Damage Boost % Buff" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding PartyDamageBoost, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Smite % Buff" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding PartySmiteBuff, UpdateSourceTrigger=LostFocus}"/></Grid>

                                <TextBlock Text="Boss defense" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,8,0,4"/>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boss Damage Tolerance %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding BossDamageTolerance, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boss Smite Resist %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding BossSmiteResist, UpdateSourceTrigger=LostFocus}"/></Grid>

                                <TextBlock Text="Assumptions" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,8,0,4"/>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Crit Chance %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding CritChance, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Back Attack Rate %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding BackAttackRate, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Front Attack Rate %" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding FrontAttackRate, UpdateSourceTrigger=LostFocus}"/></Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Positional attack:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                    <RadioButton Content="None" IsChecked="{Binding IsAttackTypeNone}" Foreground="{StaticResource PrimaryTextBrush}" Margin="10,0,0,0"/>
                                    <RadioButton Content="Front" IsChecked="{Binding IsAttackTypeFront}" Foreground="{StaticResource PrimaryTextBrush}" Margin="10,0,0,0"/>
                                    <RadioButton Content="Back" IsChecked="{Binding IsAttackTypeBack}" Foreground="{StaticResource PrimaryTextBrush}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" Margin="4,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Option Simulator" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Delta values are editable. Negative values are allowed in this block."
                                           Foreground="#8B949E"
                                           FontSize="10"
                                           FontFamily="{StaticResource MeterMonoFont}"
                                           Margin="0,0,0,6"/>

                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack (Base) Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionBaseAttack, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack (Gear) Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionGearAttack, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Max Attack Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionMaxAttack, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pve Attack Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionPveAttack, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boss Attack Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionBossAttack, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Attack Increase % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionAttackIncreasePercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Damage Boost % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionDamageBoostPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Weapon Damage Boost % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionWeaponDamageBoostPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Crit Damage Boost % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionCriticalDamageBoostPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Perfect % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionPerfectPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Smite % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionSmitePercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Front Attack Damage Boost % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionFrontDamageBoostPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                                <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Back Attack Damage Boost % Δ" Style="{StaticResource LabelStyle}"/><TextBox Grid.Column="1" Tag="AllowNegative" Style="{StaticResource InputStyle}" Text="{Binding OptionBackDamageBoostPercent, UpdateSourceTrigger=LostFocus}"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SectionBorderStyle}" Background="#1B2330" BorderBrush="{StaticResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="Final output" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Total Damage" Style="{StaticResource LabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding TotalDamage, StringFormat=N2}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource MeterMonoFont}" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid>
                            <Grid Style="{StaticResource RowGridStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Total Damage (With Option)" Style="{StaticResource LabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding TotalDamage2, StringFormat=N2}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource MeterMonoFont}" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid>
                            <TextBlock Text="{Binding EffectiveAttackPowerChangeText}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       FontFamily="{StaticResource MeterMonoFont}"
                                       Margin="0,6,0,0"/>
                            <Border Background="#1F2E2530" BorderBrush="#2C7EE787" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Damage Gain %" Style="{StaticResource LabelStyle}" FontWeight="Bold" Foreground="#A5F3C2"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DamageGainPercent, StringFormat={}{0:N2}%}" Foreground="#7EE787" FontFamily="{StaticResource MeterMonoFont}" FontWeight="Bold" FontSize="18" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
