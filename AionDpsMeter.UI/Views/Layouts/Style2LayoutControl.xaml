<UserControl x:Class="AionDpsMeter.UI.Views.Layouts.Style2LayoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <FontFamily x:Key="MeterMonoFont">pack://application:,,,/AionDpsMeter.UI;component/Assets/Fonts/#JetBrains Mono</FontFamily>
        <FontFamily x:Key="MeterMonoFontFallback">Consolas</FontFamily>

      
        <LinearGradientBrush x:Key="HeaderGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0202226" Offset="0"/>
            <GradientStop Color="#F5121316" Offset="1"/>
        </LinearGradientBrush>

        <!-- HP bar: gradient with a bright leading edge instead of flat red -->
        <LinearGradientBrush x:Key="HpBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7A2320" Offset="0"/>
            <GradientStop Color="#E0524A" Offset="0.6"/>
            <GradientStop Color="#FF6F63" Offset="1"/>
        </LinearGradientBrush>

        <!-- HP bar top-edge shine (glass bevel) -->
        <LinearGradientBrush x:Key="BarShineBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>

        <!-- Row background bevel highlight (used on every player row) -->
        <LinearGradientBrush x:Key="RowShineBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1AFFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OtherPlayerFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF16C060" Offset="0"/>
            <GradientStop Color="#FF0D6B35" Offset="0.85"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SelfPlayerFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFA64CF5" Offset="0"/>
            <GradientStop Color="#FF5E2B8C" Offset="0.85"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="OtherPlayerEdgeBrush" Color="#3DDC7A"/>
        <SolidColorBrush x:Key="SelfPlayerEdgeBrush" Color="#B266FF"/>

        <!-- Reusable glow effects. DropShadowEffect with ShadowDepth=0 renders as an even glow. -->
        <DropShadowEffect x:Key="TealTextGlow" Color="#4ADFC4" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="HpBarGlow" Color="#E0524A" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="GreenEdgeGlow" Color="#3DDC7A" BlurRadius="8" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="PurpleEdgeGlow" Color="#B266FF" BlurRadius="8" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="PanelDropShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.45" Direction="270"/>

        <!-- Player row style: strips default ListBoxItem chrome so our own Border/Grid controls the visuals -->
        <Style x:Key="PlayerRowContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            ============================================================
            HEADER — neutral black/gray glass panel
            ============================================================
        -->
        <Border Grid.Row="0"
                Margin="0,0,0,6"
                Padding="8,7"
                CornerRadius="6"
                Opacity="0.90"
                Background="{StaticResource HeaderGlassBrush}"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource PanelDropShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="4"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ActiveTargetName}"
                               FontFamily="{StaticResource MeterMonoFont}"
                               FontSize="12.5" FontWeight="Bold" Foreground="#F2F1F5"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Rectangle Width="2" Height="4" Margin="0,0,1,0" VerticalAlignment="Bottom"
                                           Fill="{Binding PingColor, Converter={StaticResource StringToBrushConverter}}"/>
                                <Rectangle Width="2" Height="6" Margin="0,0,1,0" VerticalAlignment="Bottom"
                                           Fill="{Binding PingColor, Converter={StaticResource StringToBrushConverter}}"/>
                                <Rectangle Width="2" Height="8" VerticalAlignment="Bottom"
                                           Fill="{Binding PingColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PingDisplay}"
                                       FontFamily="{StaticResource MeterMonoFont}"
                                       FontSize="10.5" FontWeight="Bold"
                                       Foreground="{Binding PingColor, Converter={StaticResource StringToBrushConverter}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding CombatDuration}"
                                   FontFamily="{StaticResource MeterMonoFont}"
                                   FontSize="11" Foreground="#A1A8B8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button Content="☰" Width="18" Height="18" FontSize="10" Margin="1,0" ToolTip="History" Click="HistoryButton_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#8B8FA3" Padding="0"/>
                        <Button Content="⚔" Width="18" Height="18" FontSize="10" Margin="4,0,4,0" ToolTip="Stat efficiency calculator" Click="StatEfficiencyCalculatorButton_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#8B8FA3" Padding="0"/>
                        <Button Content="⚙" Width="18" Height="18" FontSize="10" Margin="1,0" ToolTip="Settings" Click="SettingsButton_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#8B8FA3" Padding="0"/>
                        <Button Content="━" Width="18" Height="18" FontSize="8" Margin="1,0" Click="MinimizeButton_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#8B8FA3" Padding="0"/>
                        <Button Content="✕" Width="18" Height="18" FontSize="8" Margin="1,0,0,0" Click="CloseButton_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#8B8FA3" Padding="0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTargetHpDisplay}" FontFamily="{StaticResource MeterMonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C9807A"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TotalRaidDamageFormatted}"
                               FontFamily="{StaticResource MeterMonoFont}"
                               FontSize="17" FontWeight="Bold" Foreground="#4ADFC4"
                               Effect="{StaticResource TealTextGlow}"
                               VerticalAlignment="Center"/>
                </Grid>

  
                <Grid x:Name="Style2HpBarContainer"
                      Grid.Row="4"
                      Height="4"
                      Visibility="{Binding ActiveTargetHpTotal, Converter={StaticResource IntToVisibilityConverter}}">
                    <Border x:Name="HpBarBackground" Background="#4D4D4D" CornerRadius="2"/>
                    <Border Background="{StaticResource HpBarBrush}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Effect="{StaticResource HpBarGlow}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                <Binding Path="ActiveTargetHpPercentage"/>
                                <Binding ElementName="Style2HpBarContainer" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                        <Border CornerRadius="2" Background="{StaticResource BarShineBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

       
        <Border Grid.Row="1"
                Background="#1A2A1A" BorderBrush="#3A6B3A" BorderThickness="0,1,0,1"
                CornerRadius="4"
                Padding="8,4"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#4CAF50"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding UpdateVersionText}"
                           FontSize="10" Foreground="#A5D6A7"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="What's New" Height="18" FontSize="10"
                        Margin="6,0,4,0" Padding="6,0" Click="WhatsNewButton_Click"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#1F4D1F" Foreground="#A5D6A7"/>
                <Button Grid.Column="3" Content="✕" Width="18" Height="18" FontSize="9"
                        Padding="0" Command="{Binding DismissUpdateCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="Transparent" Foreground="#6A8F6A"/>
            </Grid>
        </Border>

        <!--
            ============================================================
            PLAYER LIST
            ============================================================
        -->
        <Grid Grid.Row="2" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Players}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlayerRowContainerStyle}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="PlayerItem_Click">
                            <Border.Tag>
                                <Binding/>
                            </Border.Tag>
                            <Grid>
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding PlayerRowScale}" ScaleY="{Binding PlayerRowScale}"/>
                                </Grid.LayoutTransform>

                                <Border x:Name="RowRoot"
                                        Margin="0,0,0,5"
                                         Background="#44000000"
                                        CornerRadius="7"
                                        BorderBrush="#0FFFFFFF"
                                        BorderThickness="1"
                                        SizeChanged="RowRoot_SizeChanged">
                                    <Grid>

                                        <!-- Damage fill -->
                                        <Border HorizontalAlignment="Left"
                                                Background="{Binding IsUser, Converter={StaticResource BoolToProgressBrushConverter}}"
                                                 Opacity="0.90">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                    <Binding Path="EffectivePercentage"/>
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>

                                        <!-- Glass bevel highlight across the top of the row -->
                                        <Border Background="{StaticResource RowShineBrush}" IsHitTestVisible="False"/>


                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="Transparent">
                                                <Grid>
                                                    <Border Width="32" Height="32"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Center"
                                                            Margin="0,-2,0,0">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="3" Opacity="0.6"/>
                                                        </Border.Effect>
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding ClassIcon, Converter={StaticResource SafeImageSourceConverter}}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="{Binding CombatPower, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding CombatPower}" FontFamily="{StaticResource MeterMonoFont}" FontSize="10" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.7"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Column="1" Margin="8,5,10,5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding PlayerNameDisplay}"
                                                           FontFamily="{StaticResource MeterMonoFont}"
                                                           FontSize="11.5" FontWeight="Bold" Foreground="#F2F1F5"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="CRIT " FontSize="8.5" Foreground="#6A6E80" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CriticalRate, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MeterMonoFont}" FontSize="9" Foreground="#9BA1B4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding PlayerDeathsDisplay}"
                                                               FontSize="9"
                                                               Foreground="#D96464"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsDeathDisplayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DpsFormatted, StringFormat={}{0:F1}/s}" FontFamily="{StaticResource MeterMonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="#E8E7EE" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding DamagePercentage, StringFormat={}{0:F1}%}"
                                                               FontFamily="{StaticResource MeterMonoFont}"
                                                               FontSize="12" FontWeight="Bold" Width="40" TextAlignment="Right"
                                                               Foreground="White"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding TotalDamageFormatted}"
                                                           FontFamily="{StaticResource MeterMonoFont}"
                                                           FontSize="9.5" FontWeight="SemiBold" Foreground="#A1A8B8"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
