@implements IDisposable

@if (settings.Enabled)
{
    <div class="timed-icon-overlay @(IsEditable ? "editable" : "")" style="@ContainerStyle" @onmousedown="BeginDrag">
        <div class="timed-icon-overlay__track" style="@TrackStyle">
            @foreach (var item in OrderedItems)
            {
                <div class="timed-icon-overlay__icon @(item.IsExpiring ? "blink" : "")"
                     style="@IconStyle">
                    <img src="@item.IconUrl" draggable="false"/>
                    <span class="timed-icon-overlay__time" style="@CdTextStyle">@FormatTimeLeft(item.TimeLeft)</span>
                </div>
            }
        </div>
    </div>
}

<style>
    .timed-icon-overlay {
        position: absolute;
        top: 0;
        left: 0;
        user-select: none;
        box-sizing: border-box;
    }

        .timed-icon-overlay.editable {
            background-color: rgba(0, 0, 0, 0.35);
            border: 1px dashed rgba(255, 255, 255, 0.5);
            border-radius: 4px;
            cursor: move;
        }

    .timed-icon-overlay__track {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
    }

    .timed-icon-overlay__icon {
        position: relative;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        overflow: hidden;
    }

        .timed-icon-overlay__icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            pointer-events: none;
        }

    .timed-icon-overlay__time {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-weight: 700;
        color: #fff;
        text-shadow: 0 0 2px #000, 0 0 4px #000;
        pointer-events: none;
        white-space: nowrap;
    }

    .timed-icon-overlay__icon.blink {
        animation: timed-icon-overlay-blink 1.2s ease-in-out infinite;
    }

    @@keyframes timed-icon-overlay-blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }
</style>

