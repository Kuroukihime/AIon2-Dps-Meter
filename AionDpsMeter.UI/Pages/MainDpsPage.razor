@using AionDpsMeter.Services.Services.Session
@using AionDpsMeter.Services.Services.Settings
@using AionDpsMeter.Services.Services.Update
@using AionDpsMeter.UI.Services.Windowing
@using AionDpsMeter.UI.ViewModels
@implements IDisposable
@page "/"
@if(UiStyle == 1)
{
    <MainDpsStyle2 viewModel="@viewModel" />
}
else
{
   <MainDpsMinimal viewModel="@viewModel" /> 
}

@code {
    [Inject] private CombatSessionManager SessionManager { get; set; } = null!;
    [Inject] private IAppSettingsService SettingsService { get; set; } = null!;
    [Inject] private UpdateCheckerService UpdateChecker { get; set; } = null!;
    [Inject] private IWindowManagerService WindowManager { get; set; } = null!;
    [Inject] private WindowHelper WindowHelper { get; set; } = null!;

    private int UiStyle => SettingsService.UiStyle;

    private MainDpsViewModel? viewModel;

    protected override void OnInitialized()
    {
        viewModel = new MainDpsViewModel(SessionManager, SettingsService, UpdateChecker, WindowManager, WindowHelper, () => InvokeAsync(StateHasChanged));
        viewModel.Initialize();
    }

    public void Dispose()
    {
        viewModel?.Dispose();
    }

}




